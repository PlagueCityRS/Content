[label,shortcut_arandar_rocks](boolean $up)
def_int $level = 68;
def_coord $dest = 0_36_50_34_53;
if ($up = true) {
    $dest = 0_36_50_28_52;
}
if (distance(coord, 0_36_51_41_33) < 8) {
    $level = 59;
    $dest = 0_36_51_40_30;
    if ($up = true) {
        $dest = 0_36_51_42_36;
    }
} else if (distance(coord, 0_36_51_34_19) < 8) {
    $level = 85;
    $dest = 0_36_51_34_22;
    if ($up = true) {
        $dest = 0_36_51_34_17;
    }
}
if (~shortcut_level($level) = false) {
    return;
}
if ($up = true) {
    ~agility_exactmove(human_climbing_down, 0, 2, coord, $dest, 0, 120, ~shortcut_dir(coord, $dest), false);
} else {
    ~agility_exactmove(death_human_climbing_down, 0, 2, coord, $dest, 0, 120, ~shortcut_dir(coord, $dest), false);
}
anim(null, 0);

