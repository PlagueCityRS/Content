[proc,macro_event_freaky_forester_spawn]
if (~macro_event_kidnap_allowed = false) {
    ~macro_event_general_spawn(~macro_event_set_random);
    return;
}
def_coord $event_coord = map_findsquare(coord, 1, 1, ^map_findsquare_lineofwalk);
if ($event_coord = null) {
    return;
}
npc_add($event_coord, macro_forester_m, 10);
npc_facesquare(coord);
npc_say("Ah, <displayname>, just the person I need!");
%macro_event = ^macro_freaky_forester;
p_delay(1);
~macro_event_disappear;
%macro_forester_state = ^forester_none;
%macro_forester_task = add(random(4), 1);
~macro_event_kidnap(0_40_74_39_41);
~macro_freaky_forester_talk;

[mapzone,0_40_74]
%macro_event = ^macro_freaky_forester;
@music_playbyregion(coord);

[mapzoneexit,0_40_74]
~macro_events_varps_reset;

[opnpc1,macro_forester_m]
if (%macro_event ! ^macro_freaky_forester | ~inzone_coord_pair_table(random_event_freaky_forester_zones, coord) = false) {
    mes("They aren't interested in talking to you.");
    return;
}
~macro_freaky_forester_talk;

[proc,macro_freaky_forester_talk]
if (inv_total(inv, raw_macro_pheasant_bad) > 0 & %macro_forester_state ! ^forester_complete) {
    inv_del(inv, raw_macro_pheasant_bad, 1);
    %macro_forester_state = ^forester_none;
    ~chatnpc_specific("Freaky Forester", macro_forester_m, "<p,neutral>That's not the right one.");
    return;
}
if (inv_total(inv, raw_macro_pheasant_good) > 0 | %macro_forester_state = ^forester_complete) {
    inv_del(inv, raw_macro_pheasant_good, 1);
    %macro_forester_state = ^forester_complete;
    if (npc_find(coord, macro_forester_m, 15, 0) = true) {
        npc_say("Thanks, <displayname>, you may leave the area now.");
    }
    ~chatnpc_specific("Freaky Forester", macro_forester_m, "<p,neutral>Thanks, <displayname>, you may leave the area now.");
    return;
}
if (%macro_forester_task = 0) {
    %macro_forester_task = add(random(4), 1);
}
def_string $tails = "one";
switch_int (%macro_forester_task) {
    case 2 : $tails = "two";
    case 3 : $tails = "three";
    case 4 : $tails = "four";
}
~chatnpc_specific("Freaky Forester", macro_forester_m, "<p,neutral>Hey there <displayname>. Can you kill the <$tails> tailed pheasant please. Bring me the raw pheasant when you're done.");

[proc,macro_freaky_forester_pheasant_attackable]()(boolean)
if (%macro_forester_state = ^forester_complete) {
    mes("You don't need to attack any more pheasants. You're allowed to leave.");
    return(false);
}
if (inv_total(inv, raw_macro_pheasant_good) > 0 | inv_total(inv, raw_macro_pheasant_bad) > 0 | %macro_forester_state = ^forester_killed) {
    mes("You don't need to attack any more pheasants.");
    return(false);
}
return(true);

[ai_queue3,_macro_pheasant]
gosub(npc_death);
if (npc_findhero = ^true) {
    if (%macro_event = ^macro_freaky_forester) {
        if (npc_type = enum(int, npc, macro_pheasants, %macro_forester_task)) {
            obj_add(npc_coord, raw_macro_pheasant_good, 1, ^lootdrop_duration);
        } else {
            obj_add(npc_coord, raw_macro_pheasant_bad, 1, ^lootdrop_duration);
        }
        %macro_forester_state = ^forester_killed;
    }
}

[oploc1,forester_forcewall]
if (%macro_forester_state ! ^forester_complete) {
    mes("A supernatural force prevents you from leaving.");
    return;
}
~macro_return_teleport;
~macro_freaky_forester_cleanup;
p_delay(1);
~macro_freaky_forester_reward;

[proc,macro_freaky_forester_cleanup]
%macro_forester_task = 0;
%macro_forester_state = ^forester_none;
inv_del(inv, raw_macro_pheasant_good, ^max_32bit_int);
inv_del(bank, raw_macro_pheasant_good, ^max_32bit_int);
inv_del(inv, raw_macro_pheasant_bad, ^max_32bit_int);
inv_del(bank, raw_macro_pheasant_bad, ^max_32bit_int);

[proc,macro_freaky_forester_reward]
if (~obj_gettotal(laderhosen_hat) = 0) {
    inv_add(inv, laderhosen_hat, 1);
} else if (~obj_gettotal(laderhosen_top) = 0) {
    inv_add(inv, laderhosen_top, 1);
} else if (~obj_gettotal(laderhosen_legs) = 0) {
    inv_add(inv, laderhosen_legs, 1);
} else {
    inv_add(inv, coins, 500);
    ~chatnpc_specific("Freaky Forester", macro_forester_m, "<p,neutral>You get some money for your help, many thanks!");
    return;
}
~chatnpc_specific("Freaky Forester", macro_forester_m, "<p,neutral>You get a lederhosen item as a reward for your help, many thanks!");
