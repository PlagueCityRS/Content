[tog_reward_messages]
inputtype=stat
outputtype=string
val=cooking,You have a brief urge to cook some food.
val=crafting,Your fingers feel nimble and suited to delicate work.
val=firemaking,You have a brief urge to set light to something!
val=fishing,You gain a deep understanding of the creatures of the sea.
val=magic,You feel magical power coursing through your body.
val=mining,You gain a deep understanding of the stones of the earth.
val=prayer,You suddenly feel very close to the gods.
val=ranged,Your aim improves.
val=runecraft,You gain a deep understanding of runes.
val=smithing,You gain a deep understanding of metal.
val=woodcutting,You gain a deep understanding of the trees in the forest.
val=agility,You feel very nimble.
val=herblore,You gain a deep understanding of all kinds of strange plants.
val=fletching,You gain a deep understanding of wooden sticks.
val=thieving,You feel your respect for others' property slipping away.
val=attack,You feel a brief surge of aggression!
val=defence,You feel very defensive!
val=strength,Your muscles bulge!
val=hitpoints,You feel more healthy.
