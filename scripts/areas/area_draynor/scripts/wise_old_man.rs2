// Dialogue is shared between osrs and rs3 unless stated otherwise

[opnpcu,wise_old_man]
if (%wom_task < 1) {
    ~chatnpc("<p,neutral>Humph! You could at least say hello before|waving your items in my face.");
} else {
    // todo
}

[opnpc1,wise_old_man]
~chatnpc("<p,happy>Greetings, <displayname>.");
if (%wom_task < 1) {
    @wom_intro;
} else {
    @wom_main;
}

[label,wom_intro]
~chatplayer("<p,quiz>So you're a wise old man, huh?");
~chatnpc("<p,shifty>Less of the 'old' man, if you please!");
~chatnpc("<p,happy>But yes, I suppose you could say that. I prefer to|think of myself as a sage.");
~chatplayer("<p,quiz>So what's a sage doing here?");
~chatnpc("<p,neutral>I've spent most of my life studying this world in which|we live. I've strode through the depths of the deadliest|dungeons, roamed the murky jungles of Karamja,|meditated on the glories of Saradomin on Entrana,");
~chatnpc("<p,neutral>and read dusty tomes in the Library of Varrock.");
~chatnpc("<p,happy>Now I'm not as young as I used to be, I'm settling|here where it's peaceful.");
if (%vampire ! ^vampire_complete) {
    ~chatnpc("<p,sad>It's a pity about that vampyre that keeps attacking the|village. At least Saradomin protects me.");
}
~chatplayer("<p,neutral>That's quite an exciting life you've had.");
~chatnpc("<p,laugh>Exciting? Yes, I suppose so.");
~chatnpc("<p,happy>Now I'm here, perhaps I could offer you the benefit of|my experience and wisdom?");
~chatplayer("<p,happy>Thanks! So how can you help me?");
%wom_task = 1;
~chatnpc("<p,happy>Well, I imagine you've gathered up quite a lot of stuff|on your travels. Things you used for quests a long|time ago that you don't need now.");
~chatnpc("<p,neutral>If you like, I can look through your bank and see if|there's anything you can chuck away.");
~chatnpc("<p,neutral>Alternatively, you can bring items here and show them|to me. If I see that it's something you don't need, I'll|let you know. I might even be willing to buy it.");
~chatplayer("<p,neutral>So you'll help me clear junk out of my bank?");
~chatnpc("<p,happy>Yes, that's right. Or I'd be happy to chat with you|about the wonders of this world!");
def_int $choice = ~p_choice5_header("Could I have some free stuff, please?", 1, "I'd just like to ask you something.", 2, "Is there anything I can do for you?", 3, "Could you check my items for junk, please?", 4, "Thanks, maybe some other time.", 5, "What would you like to say?");
if ($choice = 1) {
    @wom_free_stuff;
} else if ($choice = 2) {
    @wom_ask_something;
} else if ($choice = 3) {
    @wom_anything_to_do;
} else if ($choice = 4) {
    @wom_check_junk;
} else if ($choice = 5) {
    @wom_farewell;
}

[label,wom_main]
def_int $choice = ~p_choice3_header("Is there anything I can do for you?", 1, "Could you check my items for junk, please?", 2, "I'd just like to ask you something.", 3, "What would you like to say?");
if ($choice = 1) {
    @wom_anything_to_do;
} else if ($choice = 2) {
    @wom_check_junk;
} else if ($choice = 3) {
    @wom_ask_something;
}

[label,wom_free_stuff]
~chatplayer("<p,shifty>Could I have some free stuff, please?");
~chatnpc("<p,sad>Deary deary me...");
if (map_members = ^false) {
    ~chatnpc("<p,neutral>I'm not giving out free money, but if you log into a|members' world I'd be glad to reward you if you'd do a|little job for me."); // rs3
} else {
    // todo
}

[label,wom_ask_something]
~chatplayer("<p,happy>I'd just like to ask you something.");
~chatnpc("<p,happy>Please do!");
@wom_topics;

[label,wom_anything_to_do]
~chatplayer("<p,happy>Is there anything I can do for you?");
if (map_members = ^false) {
    ~chatnpc("<p,happy>Thanks, but I don't have anything I need doing right|now.");
} else {
    // todo
}

[label,wom_check_junk]
~chatplayer("<p,happy>Could you check my items for junk, please?");
// todo

[label,wom_farewell]
~chatplayer("<p,shifty>Thanks, maybe some other time.");
~chatnpc("<p,neutral>As you wish. Farewell, <displayname>.");

[label,wom_hat]
~chatplayer("<p,neutral>I want to ask you about your hat.");
~chatnpc("<p,happy>Why, thank you! I rather like it myself.");
def_int $choice = ~p_choice2_header(~wom_hat_accusation, 1, "How can I get a hat like that?", 2, "What would you like to say?");
if ($choice = 1) {
    @wom_hat_accuse;
} else if ($choice = 2) {
    @wom_how;
}

[proc,wom_hat_accusation]()(string)
if (%wom_bankjob < 1) {
    return("Where did you get it?");
} else if (%wom_bankjob = 1) {
    return("Did you steal it from the bank?");
} else if (%wom_bankjob = 2) {
    return("You stole it off that woman in the bank!");
}
return("You should give it back, you know.");

[label,wom_hat_accuse]
if (%wom_bankjob < 1) {
    @wom_where;
} else if (%wom_bankjob = 1) {
    @wom_steal;
} else if (%wom_bankjob = 2) {
    @wom_stole_from_woman;
} else {
    @wom_give_back;
}

[label,wom_steal]
~chatplayer("<p,neutral>Did you steal it from the bank?");
~chatnpc("<p,shock>Me? Steal from the bank?|Whatever do you mean?");
~chatplayer("<p,neutral>There's been a break-in at Draynor Bank,|and I bet you did it.");
~chatnpc("<p,shock>Oh my goodness, what in the world could make you|think I did such a thing?");
~chatplayer("<p,neutral>Well, you've been sitting here looking at the bank ever|since you moved into this house. Now someone's robbed|the bank, and suddenly your house is full of expensive|stuff!");
~chatnpc("<p,laugh>Oh dear, oh dear...");
~chatnpc("<p,shifty>So what do you think I did? March across the street,|smash the bank wall, knock out the bankers and steal all|the money?");
~chatnpc("<p,laugh>I'm an old man! I walk with a stick!|How could I possibly have done that?");
~chatplayer("<p,confused>So you didn't rob the bank?");
~chatnpc("<p,laugh>Just run along now, and don't worry yourself about|me or my finances!");
~chatplayer("<p,confused>Hmmm... But I'll be keeping an eye on you.");
@wom_off_chest;

[label,wom_stole_from_woman]
~chatplayer("<p,angry>You stole it off that woman in the bank!|You stole all this valuable stuff too!");
~chatnpc("<p,shock>Stole it? How could you possibly|think I did such a thing?");
~chatplayer("<p,angry>I saw you robbing the bank!|You killed all those people!");
~chatnpc("<p,sad>Deary me, <displayname>, your imagination is running|wild! What could make you think you saw me do that?");
~chatplayer("<p,angry>I've seen a security recording that shows you robbing|the bank. The bank's guard showed it to me.");
~chatnpc("<p,shifty>You've seen the bank's security recording?");
~chatnpc("<p,sad>Tut tut tut... Oh well, at least you'll never be able to|tell the bank about me. They'll never listen.");
%wom_bankjob = 3;
~chatplayer("<p,angry>So you're just going to get away with it?");
~chatnpc("<p,neutral>That's my plan, yes.");
~chatplayer("<p,sad>But that's... well, it's WRONG!");
~chatnpc("<p,angry>Wrong? WRONG? I'll tell you what's wrong!");
~chatnpc("<p,angry>I've spent my whole life travelling the world, doing|quests for people, saving lives, saving villages from|terrifying monsters and all that sort of thing.");
~chatnpc("<p,angry>Now I'm old, and where do I have to live? In this|freezing old house next to a pig-sty, with a bunch of|yobs outside who can't keep their hands off the market|stalls! What sort of reward is that?");
~chatnpc("<p,angry>So don't talk to me about right and wrong!");
~chatplayer("<p,angry>Maybe someone SHOULD talk to you|about right and wrong...");
~chatnpc("<p,angry>Bah!");
~chatplayer("<p,angry>Hmmph!");
@wom_off_chest;

[label,wom_where]
~chatplayer("<p,quiz>Where did you get it?");
~chatnpc("<p,happy>Oh, I saw it on the floor when I was out for my|morning stroll.");
~chatplayer("<p,shock>You found a PARTY HAT on the floor?!");
~chatnpc("<p,happy>Yes, that's right. Would you like|to ask me about something else?");
@wom_hat_followup;

[label,wom_how]
~chatplayer("<p,quiz>How can I get a hat like that?");
~chatnpc("<p,neutral>You could buy one off another player, or wait until|they're next made available by the Council."); // osrs
~chatplayer("<p,quiz>Can I buy your hat?");
~chatnpc("<p,laugh>Ohhh no, I don't intend to part with this.|Would you like to ask me about something else?");
def_int $choice = ~p_choice3_header(~wom_hat_accusation, 1, "Yes please.", 2, "Thanks, maybe some other time.", 3, "What would you like to say?");
if ($choice = 1) {
    @wom_hat_accuse;
} else if ($choice = 2) {
    @wom_yes_please;
} else if ($choice = 3) {
    @wom_farewell;
}

[label,wom_give_back]
~chatplayer("<p,neutral>You should give it back, you know.");
~chatnpc("<p,neutral>No, I think I'll keep it.");
~chatplayer("<p,quiz>But...");
@wom_off_chest;

[label,wom_yes_please]
~chatplayer("<p,happy>Yes please.");
@wom_topics;

[label,wom_off_chest]
~chatnpc("<p,neutral>Now you've got that off your chest, would you like to|ask me about anything else?");
@wom_hat_followup;

[label,wom_hat_followup]
def_int $choice = ~p_choice3_header("How can I get a hat like that?", 1, "Yes please.", 2, "Thanks, maybe some other time.", 3, "What would you like to say?");
if ($choice = 1) {
    @wom_how;
} else if ($choice = 2) {
    @wom_yes_please;
} else if ($choice = 3) {
    @wom_farewell;
}

[label,wom_topics]
def_int $choice = ~p_choice5_header("Distant lands", 1, "Strange beasts", 2, "Days gone by", 3, "Gods and demons", 4, "Your hat!", 5, "Pick a topic");
if ($choice = 1) {
    @wom_distant_lands;
} else if ($choice = 2) {
    @wom_strange_beasts;
} else if ($choice = 3) {
    @wom_days;
} else if ($choice = 4) {
    @wom_gods;
} else if ($choice = 5) {
    @wom_hat;
}

[label,wom_distant_lands]
~displaymessage(^dm_default);
// todo

[label,wom_strange_beasts]
~displaymessage(^dm_default);
// todo

[label,wom_days]
~displaymessage(^dm_default);
// todo

[label,wom_gods]
~displaymessage(^dm_default);
// todo
