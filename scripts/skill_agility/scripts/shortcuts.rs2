[oploc1,lumbridge_sc_stepstone]
if (~shortcut_members = false | ~shortcut_level(31) = false) {
    return;
}
def_int $dx = 1;
def_coord $start = 0_49_52_13_35;
if (coordx(coord) > 3151) {
    $dx = -1;
    $start = 0_49_52_18_35;
}
~forcewalk2($start);
def_int $dir = ~shortcut_dir($start, movecoord($start, $dx, 0, 0));
def_int $hop = 0;
while ($hop < 5) {
    sound_synth(jump_no_land, 1, 0);
    ~agility_exactmove(human_steppingstonejump, 20, 1, coord, movecoord(coord, $dx, 0, 0), 48, 60, $dir, false);
    $hop = calc($hop + 1);
}
stat_advance(agility, 30);

